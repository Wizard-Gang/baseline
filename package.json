{
  "name": "baseline",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "WizardGang change-management reference implementation",
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "packageManager": "npm@12.1.0",
  "scripts": {
    "check": "npm run test:plan-queue && npm run check:workflow-shell && node --test tests/*.test.mjs && node scripts/check-repository.mjs && node contract/check-change.mjs",
    "check:gate": "node contract/check-portfolio-contract.mjs && npm run check:workflow-shell && npm run check:repository",
    "check:workflow-shell": "node contract/check-workflow-shell.mjs",
    "check:change": "node contract/check-change.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "check:release": "node contract/check-release.mjs",
    "check:patch": "node contract/check-patch.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify:github-settings": "node contract/verify-github-repository-settings.mjs",
    "apply:github-settings": "node contract/apply-github-repository-settings.mjs",
    "verify:cloudflare": "node scripts/verify-cloudflare.mjs",
    "discover:cloudflare-token-targets": "node scripts/discover-cloudflare-token-targets.mjs",
    "rotate:cloudflare-token": "node scripts/rotate-cloudflare-token.mjs",
    "test:plan-queue": "node contract/check-portfolio-contract.mjs",
    "test:github-settings": "node --test tests/github-settings.test.mjs",
    "vendor:lock": "node scripts/vendor-lock.mjs",
    "link:agent": "node scripts/link-agent.mjs"
  }
}
