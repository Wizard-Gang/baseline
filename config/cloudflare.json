{
  "schemaVersion": 1,
  "zone": "wizardgang.ai",
  "compatibility": {
    "date": "2026-08-31",
    "flags": ["nodejs_compat"]
  },
  "workerSettings": {
    "observability": true,
    "workersDev": false,
    "previewUrls": false
  },
  "routes": [],
  "workers": {
    "wizardgang": {
      "repository": "Wizard-Gang/WizardGang",
      "environment": "production",
      "host": "wizardgang.ai",
      "aliases": ["www.wizardgang.ai"],
      "durableObjects": [],
      "crons": [],
      "secrets": []
    },
    "demo": {
      "repository": "SouthernGentlemen/wizardgang-architecture-demo",
      "environment": "production",
      "host": "demo.wizardgang.ai",
      "aliases": [],
      "durableObjects": ["DemoCoordinator"],
      "crons": ["*/5 * * * *"],
      "secrets": [
        "CLOUDFLARE_API_TOKEN",
        "DEMO_SESSION_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITHUB_DEMO_TOKEN",
        "GITHUB_READ_TOKEN",
        "GITHUB_REPORTING_WRITE_TOKEN",
        "GITHUB_WEBHOOK_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "IDENTITY_AUDIT_HMAC_SECRET",
        "IDENTITY_SESSION_SECRET",
        "MICROSOFT_CLIENT_ID",
        "MICROSOFT_CLIENT_SECRET",
        "MICROSOFT_TENANT_ID",
        "SAML_IDP_CERT",
        "WEBHOOK_DEMO_SECRET"
      ]
    },
    "sharktank": {
      "repository": "Wizard-Gang/SharkTank",
      "environment": "production",
      "host": "sharktank.wizardgang.ai",
      "aliases": [],
      "durableObjects": ["Room"],
      "crons": [],
      "secrets": []
    },
    "hexframe": {
      "repository": "Wizard-Gang/Hexframe",
      "environment": "production",
      "host": "hexframe.wizardgang.ai",
      "aliases": [],
      "durableObjects": [],
      "crons": [],
      "secrets": []
    }
  },
  "d1": ["wizardgang"],
  "r2": [
    {
      "name": "wizardgang",
      "abortIncompleteMultipartUploadDays": 1,
      "prefixes": {
        "wizardgang": { "prefix": "wizardgang/", "expiry": [] },
        "demo": { "prefix": "demo/", "expiry": [{ "prefix": "demo/uploads/", "days": 1 }] },
        "sharktank": { "prefix": "sharktank/", "expiry": [] },
        "hexframe": { "prefix": "hexframe/", "expiry": [] }
      }
    }
  ],
  "kv": [],
  "secretsStore": [
    {
      "name": "default_secrets_store",
      "secrets": ["WG_OPS_TOKEN", "WG_SESSION_KEY"]
    }
  ]
}
