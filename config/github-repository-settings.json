{
  "repository": "Wizard-Gang/baseline",
  "defaultBranch": "main",
  "mergeMethods": {
    "mergeCommit": false,
    "squash": true,
    "rebase": true
  },
  "allowAutoMerge": true,
  "deleteBranchOnMerge": true,
  "immutableReleases": true,
  "rulesets": [
    {
      "name": "main-protection",
      "target": "branch",
      "enforcement": "active",
      "include": [
        "refs/heads/main"
      ],
      "bypassActors": [],
      "requireBranchUpToDate": true,
      "allowedMergeMethods": [
        "rebase"
      ],
      "requiredStatusChecks": [
        "verify",
        "change-id",
        "security"
      ],
      "rules": [
        "deletion",
        "non_fast_forward",
        "pull_request",
        "required_linear_history",
        "required_status_checks"
      ]
    },
    {
      "name": "release-branch-protection",
      "target": "branch",
      "enforcement": "active",
      "include": [
        "refs/heads/release/*"
      ],
      "bypassActors": [],
      "requireBranchUpToDate": true,
      "allowedMergeMethods": [
        "squash"
      ],
      "requiredStatusChecks": [
        "gate",
        "change-id"
      ],
      "rules": [
        "non_fast_forward",
        "pull_request",
        "required_status_checks"
      ]
    },
    {
      "name": "release-tag-immutability",
      "target": "tag",
      "enforcement": "active",
      "include": [
        "refs/tags/v*"
      ],
      "bypassActors": [],
      "rules": [
        "deletion",
        "update"
      ]
    }
  ]
}
